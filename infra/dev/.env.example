# HOROS LOCAL DEVELOPMENT ONLY
# Copy to .env.dev before starting Docker.

POSTGRES_DB=horos_dev
POSTGRES_USER=horos_dev
POSTGRES_PASSWORD=change_me_local

POSTGRES_PORT=55432

HOROS_RUNTIME_PASSWORD=change_me_runtime_local
HOROS_MIGRATOR_PASSWORD=change_me_migrator_local

REDIS_PORT=56379

# Legacy integrations are opt-in and remain disabled for canonical HOROS.
HOROS_ENABLE_LEGACY_TIDB=false
HOROS_ENABLE_MANUS_FORGE=false
HOROS_ENABLE_LEGACY_OAUTH=false
